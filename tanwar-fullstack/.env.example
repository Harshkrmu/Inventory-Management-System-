# Copy this file to .env and fill in your own values.
# Never commit the real .env file to git.

# "development" while working locally, "production" once deployed.
NODE_ENV=development

PORT=4000

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=tanwar_collections

# Used to sign login tokens (JWT). Make this a long random string.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Comma-separated list of frontend origins allowed to call this API.
# For local development, or when the frontend is served by this same
# server (the default setup here), "*" is simplest and safe.
# If you ever split the frontend onto its own domain, restrict this to
# that exact domain instead, e.g.:
#   CORS_ORIGIN=https://tanwarcollections.com
CORS_ORIGIN=*
