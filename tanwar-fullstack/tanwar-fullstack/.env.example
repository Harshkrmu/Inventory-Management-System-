# Copy this file to .env and fill in your own values.
# Never commit the real .env file to git (it is already in .gitignore).

# "development" while working locally, "production" once deployed.
NODE_ENV=development

PORT=4000

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=tanwar_collections

# Max simultaneous database connections. Keep this low on free hosted
# databases (Clever Cloud's free plan only allows a few).
DB_POOL_LIMIT=4

# OPTIONAL: signs login tokens. If you leave this empty (or too short), a
# secure key is derived from your database credentials automatically.
# For the best setup use a long random value:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# The app creates a demo login automatically so you can get in straight away
# (it is NOT shown on the login page). Set to false to turn this off.
SEED_DEMO=true

# OPTIONAL: if set, people must enter this invite code to create an account.
# Strongly recommended once the app is on a public URL, otherwise anyone who
# finds the link can sign up and edit your inventory. Leave empty to allow
# open sign-up (fine for local testing).
SIGNUP_CODE=

# Allowed origins for the API. "*" is fine because the frontend is served by
# this same server. Only change this if you host the frontend elsewhere.
CORS_ORIGIN=*
